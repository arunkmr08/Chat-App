S3_REGION=us-east-1

# AI Provider Keys (Add when ready)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# JWT (for auth later)
JWT_SECRET=your-secret-key-change-this

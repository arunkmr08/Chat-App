# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zoai_chat

# Redis
REDIS_URL=redis://localhost:6379

# S3 / Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=adminadmin
S3_BUCKET=zoai-uploads
S3_REGION=us-east-1

# AI Provider Keys (Add when ready)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Web Search (Optional - for fallback when no knowledge base context)
# Get a free API key at https://tavily.com
TAVILY_API_KEY=

# Authentication
COOKIE_SECRET=your-random-secret-change-this-to-something-secure

# Email (for magic links)
# Development: Leave blank to log magic links to console
# Production: Configure SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@zoai.app
APP_URL=http://localhost:5173

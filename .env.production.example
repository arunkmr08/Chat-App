# Production Environment Variables
# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to version control!

# ============================================================================
# DATABASE
# ============================================================================
POSTGRES_DB=zoai
POSTGRES_USER=zoai
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ============================================================================
# REDIS
# ============================================================================
REDIS_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ============================================================================
# AI API KEYS
# ============================================================================
# OpenAI (required for embeddings and GPT models)
OPENAI_API_KEY=sk-...

# Anthropic (optional - for Claude models)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI (optional - for Gemini models)
GOOGLE_AI_API_KEY=...

# ============================================================================
# CORS & SECURITY
# ============================================================================
# Your production domain (e.g., https://chat.yourdomain.com)
CORS_ORIGIN=https://yourdomain.com

# ============================================================================
# OPTIONAL: Custom Configuration
# ============================================================================
# Uncomment and modify if needed

# Server port (default: 3000)
# PORT=3000

# Node environment (should be 'production')
# NODE_ENV=production

# Database connection (if using external database)
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# Redis connection (if using external Redis)
# REDIS_HOST=redis
# REDIS_PORT=6379
